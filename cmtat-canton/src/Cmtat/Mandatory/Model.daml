module Cmtat.Mandatory.Model where

import DA.Assert (assertMsg)
import DA.List (elem)

isAuthorized : Party -> Party -> [Party] -> Bool
isAuthorized actor issuer operators = actor == issuer || elem actor operators

template TokenConfig
  with
    issuer : Party
    operators : [Party]
    readers : [Party]
    name : Text
    symbol : Text
    tokenId : Text
    termsRef : Text
    decimals : Int
    allowFractional : Bool
    paused : Bool
    deactivated : Bool
    totalSupply : Int
  where
    signatory issuer
    observer (operators ++ readers)

    ensure
      decimals >= 0
      && totalSupply >= 0
      && (decimals == 0 || allowFractional)

    nonconsuming choice TotalSupplyOf : Int
      with actor : Party
      controller actor
      do pure totalSupply

    choice Pause : ContractId TokenConfig
      with actor : Party
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        assertMsg "token deactivated" (not deactivated)
        archive self
        create this with paused = True

    choice Unpause : ContractId TokenConfig
      with actor : Party
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        assertMsg "token deactivated" (not deactivated)
        archive self
        create this with paused = False

    choice Deactivate : ContractId TokenConfig
      with actor : Party
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        assertMsg "already deactivated" (not deactivated)
        archive self
        create this with deactivated = True

template Holding
  with
    issuer : Party
    owner : Party
    tokenId : Text
    amount : Int
    frozen : Bool
  where
    signatory issuer
    observer owner

    key (issuer, tokenId, owner) : (Party, Text, Party)
    maintainer key._1

    ensure amount >= 0

template TokenAdmin
  with
    issuer : Party
    operators : [Party]
    readers : [Party]
    tokenId : Text
  where
    signatory issuer
    observer (operators ++ readers)

    nonconsuming choice BalanceOf : Int
      with
        actor : Party
        owner : Party
      controller actor
      do
        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        case mHoldingCid of
          None -> pure 0
          Some holdingCid -> do
            h <- fetch holdingCid
            pure h.amount

    choice Mint : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
        mintAmount : Int
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        assertMsg "mint amount must be positive" (mintAmount > 0)

        cfg <- fetch configCid
        assertMsg "token mismatch" (cfg.tokenId == tokenId)
        assertMsg "token deactivated" (not cfg.deactivated)

        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        case mHoldingCid of
          None -> do
            _ <- create Holding with
              issuer = issuer
              owner = owner
              tokenId = tokenId
              amount = mintAmount
              frozen = False
            pure ()
          Some holdingCid -> do
            h <- fetch holdingCid
            archive holdingCid
            _ <- create h with amount = h.amount + mintAmount
            pure ()

        archive configCid
        create cfg with totalSupply = cfg.totalSupply + mintAmount

    choice Burn : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
        burnAmount : Int
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        assertMsg "burn amount must be positive" (burnAmount > 0)

        cfg <- fetch configCid
        assertMsg "token mismatch" (cfg.tokenId == tokenId)
        assertMsg "token deactivated" (not cfg.deactivated)

        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        holdingCid <- case mHoldingCid of
          None -> abort "holding does not exist"
          Some cid -> pure cid

        h <- fetch holdingCid
        assertMsg "insufficient balance" (h.amount >= burnAmount)

        archive holdingCid
        _ <- create h with amount = h.amount - burnAmount

        archive configCid
        create cfg with totalSupply = cfg.totalSupply - burnAmount

    choice Freeze : ContractId Holding
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        cfg <- fetch configCid
        assertMsg "token mismatch" (cfg.tokenId == tokenId)
        assertMsg "token deactivated" (not cfg.deactivated)

        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        holdingCid <- case mHoldingCid of
          None -> abort "holding does not exist"
          Some cid -> pure cid

        h <- fetch holdingCid
        archive holdingCid
        create h with frozen = True

    choice Unfreeze : ContractId Holding
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
      controller actor
      do
        assertMsg "not authorized" (isAuthorized actor issuer operators)
        cfg <- fetch configCid
        assertMsg "token mismatch" (cfg.tokenId == tokenId)
        assertMsg "token deactivated" (not cfg.deactivated)

        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        holdingCid <- case mHoldingCid of
          None -> abort "holding does not exist"
          Some cid -> pure cid

        h <- fetch holdingCid
        archive holdingCid
        create h with frozen = False

    choice Transfer : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        to : Party
        transferAmount : Int
      controller actor
      do
        assertMsg "amount must be positive" (transferAmount > 0)

        cfg <- fetch configCid
        assertMsg "token mismatch" (cfg.tokenId == tokenId)
        assertMsg "token deactivated" (not cfg.deactivated)
        assertMsg "token paused" (not cfg.paused)

        mFromCid <- lookupByKey @Holding (issuer, tokenId, actor)
        fromCid <- case mFromCid of
          None -> abort "sender holding does not exist"
          Some cid -> pure cid
        fromH <- fetch fromCid

        assertMsg "sender frozen" (not fromH.frozen)
        assertMsg "insufficient balance" (fromH.amount >= transferAmount)

        mToCid <- lookupByKey @Holding (issuer, tokenId, to)
        toHolding <- case mToCid of
          None -> pure (Holding with
            issuer = issuer
            owner = to
            tokenId = tokenId
            amount = 0
            frozen = False)
          Some cid -> fetch cid

        assertMsg "receiver frozen" (not toHolding.frozen)

        archive fromCid
        _ <- create fromH with amount = fromH.amount - transferAmount

        case mToCid of
          None -> do
            _ <- create toHolding with amount = transferAmount
            pure ()
          Some cid -> do
            archive cid
            _ <- create toHolding with amount = toHolding.amount + transferAmount
            pure ()

        pure configCid
