module Cmtat.Mandatory.TokenAdmin where

import Cmtat.Mandatory.BurnModule (doBurn)
import Cmtat.Mandatory.EnforcementModule (doForcedBurn, doFreeze, doUnfreeze)
import Cmtat.Mandatory.Holding (Holding(..))
import Cmtat.Mandatory.MintModule (doMint)
import Cmtat.Mandatory.PauseModule (doDeactivate, doPause, doUnpause)
import Cmtat.Mandatory.TokenConfig (TokenConfig(..))
import Cmtat.Mandatory.TransferModule (doTransfer)

template TokenAdmin
  with
    issuer : Party
    operators : [Party]
    readers : [Party]
    tokenId : Text
  where
    signatory issuer
    observer (operators ++ readers)

    nonconsuming choice Pause : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
      controller actor
      do doPause actor issuer operators tokenId configCid

    nonconsuming choice Unpause : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
      controller actor
      do doUnpause actor issuer operators tokenId configCid

    nonconsuming choice Deactivate : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
      controller actor
      do doDeactivate actor issuer operators tokenId configCid

    nonconsuming choice BalanceOf : Int
      with
        actor : Party
        owner : Party
      controller actor
      do
        mHoldingCid <- lookupByKey @Holding (issuer, tokenId, owner)
        case mHoldingCid of
          None -> pure 0
          Some holdingCid -> do
            h <- fetch holdingCid
            pure h.amount

    nonconsuming choice Mint : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
        mintAmount : Int
      controller actor
      do doMint actor issuer operators readers tokenId configCid owner mintAmount

    nonconsuming choice Burn : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
        burnAmount : Int
      controller actor
      do doBurn actor issuer operators tokenId configCid owner burnAmount

    -- Bypasses frozen and deactivated checks.
    nonconsuming choice ForcedBurn : ContractId TokenConfig
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
        burnAmount : Int
      controller actor
      do doForcedBurn actor issuer operators tokenId configCid owner burnAmount

    nonconsuming choice Freeze : ContractId Holding
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
      controller actor
      do doFreeze actor issuer operators tokenId configCid owner

    nonconsuming choice Unfreeze : ContractId Holding
      with
        actor : Party
        configCid : ContractId TokenConfig
        owner : Party
      controller actor
      do doUnfreeze actor issuer operators tokenId configCid owner

    nonconsuming choice Transfer : ()
      with
        actor : Party
        configCid : ContractId TokenConfig
        to : Party
        transferAmount : Int
      controller actor
      do doTransfer actor issuer operators readers tokenId configCid to transferAmount
