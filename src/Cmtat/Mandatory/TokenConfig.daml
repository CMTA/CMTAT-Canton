module Cmtat.Mandatory.TokenConfig where

template TokenConfig
  with
    issuer : Party
    operators : [Party]
    readers : [Party]
    name : Text
    symbol : Text
    tokenId : Text
    termsRef : Text
    decimals : Int
    allowFractional : Bool
    paused : Bool
    deactivated : Bool
    totalSupply : Int
  where
    signatory issuer
    observer (operators ++ readers)

    ensure
      decimals >= 0
      && totalSupply >= 0
      && (decimals == 0 || allowFractional)

    nonconsuming choice TotalSupplyOf : Int
      with actor : Party
      controller actor
      do pure totalSupply
